build/

# Compilation database (symlink to build directory)
compile_commands.json

# IDE and editor files
# NOTE: .vscode/* (not .vscode/) — git won't descend into an excluded
# directory, so a negation below could never re-include anything.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Language server cache
.ccls-cache/
.cache/